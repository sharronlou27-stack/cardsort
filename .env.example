# Password required to view /admin results dashboard
ADMIN_PASSWORD=change-me

# Random long string used to sign the admin session cookie
ADMIN_SESSION_SECRET=change-me-too

# Optional: only needed in production (e.g. on Vercel). Point these at a free
# Turso database (https://turso.tech) to persist responses without a local
# disk. Leave both unset for local dev — the app falls back to a local
# SQLite file at data/survey.db.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
